{
  "manifest_version": 3,
  "name": "REFI – repjegy-árfigyelő",
  "short_name": "REFI",
  "version": "1.1.0",
  "description": "Gyors áttekintés a REFI-ben figyelt repülőjegyekről: aktuális ár, célár, árgörbe.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "REFI – figyelt repjegyek",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "identity",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}